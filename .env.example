# =============================================================================
# Assaybank — example environment
# -----------------------------------------------------------------------------
# Copy to .env and fill in the values marked CHANGE_ME:
#
#     cp .env.example .env
#     openssl rand -hex 32        # one per secret below
#
# Defaults here target the docker-compose stack and resolve by compose service
# name (postgres, valkey, piston, seaweedfs, mailpit, otel-collector). They are
# safe for local development and are not safe anywhere else.
#
# .env is gitignored. This file is committed. Never put a real secret in it.
# Every variable here is parsed and validated by packages/config at boot, is
# declared in docker-compose.yml, and is documented in
# docs/13-environments-and-release.md. Adding one means updating all four.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# Node runtime mode. "development" enables verbose errors and disables caching.
NODE_ENV=development
# Pino level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=debug
# Deployment tier this process believes it is in: local | dev | staging | production.
# Distinct from NODE_ENV: staging runs NODE_ENV=production with APP_ENV=staging.
APP_ENV=local

# -----------------------------------------------------------------------------
# HTTP API and public URLs
# -----------------------------------------------------------------------------
# Port the Fastify API listens on inside the container and on the host.
API_PORT=8080
# Absolute base URL clients use to reach the API. Appears in invitation links.
API_PUBLIC_URL=http://localhost:8080
# Absolute base URL of the staff console (recruiter / interviewer / admin).
WEB_PUBLIC_URL=http://localhost:5173
# Absolute base URL of the candidate app. Kept separate so candidate links never
# point at a staff origin.
CANDIDATE_PUBLIC_URL=http://localhost:5174
# Comma-separated exact origins allowed to call the API with credentials.
# No wildcards, ever — a wildcard here defeats the cookie same-site protection.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Superuser the container bootstraps with. infra/postgres/init/*.sql then creates
# the two least-privileged roles below. The application never connects as this.
POSTGRES_USER=hiring
POSTGRES_PASSWORD=hiring
POSTGRES_DB=hiring
# Connection string for the application role. Host is the compose service name.
DATABASE_URL=postgres://hiring_app:hiring_app@postgres:5432/hiring
# Connection string for the worker role. Separate so grading and sweep jobs can
# be granted a narrower privilege set than the request path.
DATABASE_JOB_URL=postgres://hiring_job:hiring_job@postgres:5432/hiring
# Owner DSN. Used ONLY by `pnpm run migrate`. The application role cannot alter the
# schema by design (ADR-010) — if it could, a SQL injection in a request path would
# become a schema-rewrite primitive. Locally these may be the same superuser.
DATABASE_OWNER_URL=postgres://hiring:hiring@postgres:5432/hiring

# Maximum pooled connections per process. Keep (instances x this) below the
# server's max_connections with headroom for migrations and psql.
DATABASE_POOL_MAX=10
# Role the API connects as. RLS policies are enforced against it; it is NOT the
# table owner, because a table owner bypasses row-level security by default.
DATABASE_APP_ROLE=hiring_app
DATABASE_APP_ROLE_PASSWORD=hiring_app
# Role the worker connects as. Also a non-owner, so RLS applies to sweeps too.
DATABASE_JOB_ROLE=hiring_job
DATABASE_JOB_ROLE_PASSWORD=hiring_job

# -----------------------------------------------------------------------------
# Valkey (cache, BullMQ queues, collab pub/sub)
# -----------------------------------------------------------------------------
# Valkey 8 speaks the Redis wire protocol, so the variable keeps the
# conventional name and every Redis client library works unchanged.
# Valkey, not Redis > 7.2: Redis relicensed to RSALv2/SSPL. See docs/05 §1.
REDIS_URL=redis://valkey:6379

# -----------------------------------------------------------------------------
# Object storage (S3-compatible) — SeaweedFS locally
# -----------------------------------------------------------------------------
# S3 API endpoint. SeaweedFS, not MinIO: MinIO is AGPL-3.0. See docs/05 §1.
S3_ENDPOINT=http://seaweedfs:8333
# Region string. SeaweedFS ignores it; the AWS SDK requires one to be set.
S3_REGION=us-east-1
# Bucket holding submissions, exports, session recordings and proctor media.
S3_BUCKET=hiring-dev
# Dev credentials for the local SeaweedFS S3 gateway. Replace per environment.
S3_ACCESS_KEY_ID=hiring-dev-access-key
S3_SECRET_ACCESS_KEY=hiring-dev-secret-key
# Path-style addressing (http://host/bucket/key). Required by SeaweedFS; managed
# S3 services generally want this false.
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Code execution (Piston) — used from M2
# -----------------------------------------------------------------------------
# Base URL of the self-hosted Piston API. Never expose this outside the network.
PISTON_URL=http://piston:2000
# Hard CPU-time ceiling for one execution, milliseconds.
EXEC_CPU_TIME_MS=5000
# Hard wall-clock ceiling for one execution, milliseconds. Above CPU time so a
# process blocked on I/O still terminates.
EXEC_WALL_TIME_MS=10000
# Memory ceiling per execution, megabytes. Enforced by cgroups, not the app.
EXEC_MEMORY_MB=256
# The same ceiling in bytes, for the container-level cgroup limit in compose.
# Keep the two in step: 256 MB = 268435456.
EXEC_MEMORY_MB_BYTES=268435456
# Maximum processes/threads per execution. Blocks fork bombs.
EXEC_MAX_PROCESSES=64
# Maximum combined stdout+stderr captured, bytes. Output beyond this is
# truncated, never streamed — an unbounded print loop must not fill the disk.
EXEC_MAX_OUTPUT_BYTES=65536

# -----------------------------------------------------------------------------
# Queues (BullMQ) — used from M1
# -----------------------------------------------------------------------------
# Concurrent interactive "Run" jobs per worker. Low latency, high priority.
QUEUE_RUN_CONCURRENCY=4
# Concurrent "Submit" grading jobs per worker. Batch, lower priority.
QUEUE_SUBMIT_CONCURRENCY=2
# Attempts before a job moves to the dead-letter queue. A non-empty dead-letter
# queue means ungraded submissions and pages someone.
QUEUE_MAX_ATTEMPTS=3
# Base backoff between retries, milliseconds. Exponential with jitter from here.
QUEUE_BACKOFF_MS=2000

# -----------------------------------------------------------------------------
# Collaboration service (Yjs / y-websocket) — used from M3
# -----------------------------------------------------------------------------
# Port the y-websocket server listens on.
COLLAB_PORT=8081
# Absolute WebSocket URL clients dial. wss:// in every deployed environment.
COLLAB_PUBLIC_URL=ws://localhost:8081
# How often a live document's state is snapshotted to Postgres, milliseconds.
# This is the upper bound on editor state lost if a collab node dies.
COLLAB_SNAPSHOT_INTERVAL_MS=15000

# -----------------------------------------------------------------------------
# Secrets — CHANGE_ME. Generate each with: openssl rand -hex 32
# -----------------------------------------------------------------------------
# Signs and encrypts staff session cookies. Rotating it logs every staff user out.
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
# Server-side pepper mixed into candidate attempt tokens and WebSocket tickets
# before hashing. Stored only here, never in the database — a database dump
# alone must not let anyone forge a token. Rotating it invalidates live invites.
TOKEN_PEPPER=CHANGE_ME_openssl_rand_hex_32
# Age at which an outbound webhook signing secret is rotated. Both the current
# and previous secret are accepted during overlap. See docs/09-ats-integration.md.
WEBHOOK_SIGNING_SECRET_ROTATION_DAYS=90

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# SMTP endpoint. Mailpit captures everything locally and forwards nothing, so no
# real candidate can ever receive a development invitation.
SMTP_URL=smtp://mailpit:1025
# From address on invitations, reminders and result notifications.
MAIL_FROM=no-reply@hiring.localhost

# -----------------------------------------------------------------------------
# Staff SSO (OIDC) — optional locally; password sessions work without it
# -----------------------------------------------------------------------------
# Issuer URL. Discovery is read from {issuer}/.well-known/openid-configuration.
OIDC_ISSUER=
# Client identifier registered with the identity provider.
OIDC_CLIENT_ID=
# Client secret. CHANGE_ME in any environment where OIDC is enabled.
OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Live video (LiveKit) — used from M3, not part of the default local stack
# -----------------------------------------------------------------------------
# WebSocket URL of the LiveKit SFU.
LIVEKIT_URL=
# LiveKit API key.
LIVEKIT_API_KEY=
# LiveKit API secret. CHANGE_ME wherever video is enabled.
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# OTLP gRPC endpoint of the collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Service name on emitted spans. Each app overrides it: hiring-api,
# hiring-worker, hiring-collab.
OTEL_SERVICE_NAME=hiring-api
# Head sampling ratio, 0.0-1.0. 1.0 locally; lower it in production and keep
# error and exam-window traces with a tail sampler in the collector instead.
OTEL_TRACES_SAMPLER_ARG=1.0

# -----------------------------------------------------------------------------
# Host port mappings and container-local settings
# -----------------------------------------------------------------------------
# These decide only which host port each container publishes on, so a locally
# installed Postgres or Redis can be worked around without editing compose.
# Changing one does not change the port inside the compose network, which is why
# every service-to-service URL above uses the canonical port.
POSTGRES_PORT=5432
VALKEY_PORT=6379
S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
WEB_PORT=5173
CANDIDATE_PORT=5174
# Piston is deliberately not published to the host: it has no authentication and
# it runs untrusted code. Reach it from the worker as http://piston:2000.
PISTON_LOG_LEVEL=INFO
# Local Grafana dashboard login. Development only. Grafana is an operator tool in
# infra/ and nothing in apps/ or packages/ may depend on it (it is AGPL-3.0).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Retention clocks
# -----------------------------------------------------------------------------
# These drive the retention sweep in apps/worker. They are working defaults
# pending legal sign-off; see docs/11-data-retention-and-dpia.md before changing
# any of them. Shortening a clock deletes data on the next sweep.
#
# Webcam and screen captures from proctored attempts. Biometric data carries a
# hard ceiling — do not raise this without a documented legal basis.
RETENTION_PROCTOR_MEDIA_DAYS=30
# Live interview session recordings and replay event streams.
RETENTION_SESSION_RECORDING_DAYS=90
# Attempts, answers, submissions and scores. Long enough to defend a dispute.
RETENTION_ATTEMPT_DATA_MONTHS=24
# Candidate personal data: name, email, contact details. Shorter than attempt
# data on purpose — the attempt survives pseudonymised after the PII is erased.
RETENTION_CANDIDATE_PII_MONTHS=12
# Append-only audit log. The longest clock: it is the defensibility record.
RETENTION_AUDIT_LOG_YEARS=7
