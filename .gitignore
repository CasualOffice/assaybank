# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
.yarn/
.npm/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
.output/
*.tsbuildinfo
tsconfig.tsbuildinfo
storybook-static/

# Vite / React app output
.vite/
apps/*/dist/
packages/*/dist/

# Generated API artefacts (regenerated from packages/contracts; never committed)
packages/contracts/generated/
openapi.generated.json

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.turbo/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.swc/
.rollup.cache/

# ---------------------------------------------------------------------------
# Tests, coverage, Playwright
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/
playwright/.cache/
blob-report/
.vitest/

# Load-test output (docs/07)
load-test-results/
*.jtl

# ---------------------------------------------------------------------------
# Environment and secrets
#   .env is ignored; .env.example is committed on purpose.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ---------------------------------------------------------------------------
# Docker and local infrastructure state
# ---------------------------------------------------------------------------
docker-compose.override.yml
.docker/
infra/**/data/
infra/postgres/data/
infra/seaweedfs/data/
infra/valkey/data/
infra/piston/packages/
*.pid

# Database dumps taken locally
*.dump
*.sql.gz
!docs/hiring_platform_schema.sql
!infra/postgres/init/*.sql

# ---------------------------------------------------------------------------
# Object-store and media scratch
# ---------------------------------------------------------------------------
tmp/
.tmp/
uploads/
proctor-media/
session-recordings/

# ---------------------------------------------------------------------------
# Observability scratch
# ---------------------------------------------------------------------------
infra/prometheus/data/
infra/grafana/data/
*.heapsnapshot
*.cpuprofile

# ---------------------------------------------------------------------------
# Supply chain
#   SBOMs are release artefacts, published, not committed.
# ---------------------------------------------------------------------------
sbom/
*.cdx.json
*.spdx.json

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.swp
*.swo
*~
.history/
.fleet/

# Claude Code: shared rules are committed, local overrides are not
.claude/settings.local.json
.claude/local/

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Layering fixture scratch (tests/fixtures/layering.test.ts)
#   Written and removed inside a single test. Ignored so a hard kill mid-test
#   cannot leave a deliberate layering violation committed to the tree.
# ---------------------------------------------------------------------------
packages/*/src/layering-fixture.generated.ts

# ---------------------------------------------------------------------------
# Scratch scripts run from inside a workspace
#   A throwaway fixture or probe has to live under a workspace to resolve that
#   workspace's dependencies, which puts it where `git add -A` will take it. One
#   reached `main` on 2026-09-21 and failed the licence-header gate and lint
#   before anyone read the CI result. Scratch belongs in the session scratchpad;
#   this catches the ones that do not make it there.
# ---------------------------------------------------------------------------
**/.dev-*.mjs
**/.probe*.mjs
