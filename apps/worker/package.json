{
  "name": "@assaybank/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests src/",
    "test:integration": "vitest run --passWithNoTests test/integration/",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@assaybank/config": "workspace:*",
    "@assaybank/contracts": "workspace:*",
    "@assaybank/core-domain": "workspace:*",
    "@assaybank/db": "workspace:*",
    "@assaybank/exec-adapter": "workspace:*",
    "@assaybank/grading": "workspace:*",
    "@assaybank/observability": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "bullmq": "^6.3.6",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  }
}
