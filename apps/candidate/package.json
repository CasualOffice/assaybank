{
  "name": "@assaybank/candidate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "build": "vite build && pnpm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests src/",
    "test:integration": "vitest run --passWithNoTests test/integration/",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@assaybank/contracts": "workspace:*",
    "@assaybank/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
