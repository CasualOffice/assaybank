{
  "name": "@assaybank/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests src/",
    "test:integration": "vitest run --passWithNoTests test/integration/",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@assaybank/auth": "workspace:*",
    "@assaybank/config": "workspace:*",
    "@assaybank/contracts": "workspace:*",
    "@assaybank/db": "workspace:*",
    "@assaybank/observability": "workspace:*",
    "ioredis": "^6.0.0",
    "ws": "^8.21.3",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
