{
  "name": "assaybank",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted technical hiring platform \u2014 monorepo root.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "migrate": "pnpm --filter @assaybank/db run migrate",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && vitest run --project leak --project fixtures",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:leak": "vitest run --project leak",
    "test:fixtures": "vitest run --project fixtures",
    "test:coverage": "vitest run --coverage",
    "licences": "node scripts/check-licences.mjs",
    "licence-headers": "node scripts/check-licence-headers.mjs",
    "clean": "turbo run clean && rm -rf .turbo coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
